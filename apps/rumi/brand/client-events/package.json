{
  "name": "@rumi/client-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rumi client graph events without packaged bundle polling",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-client-hmr": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  }
}

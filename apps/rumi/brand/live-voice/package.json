{
  "name": "@rumi/live-voice",
  "version": "0.8.0",
  "description": "Live, full-duplex voice for Rumi: GPT-Live listens and speaks, the harness does the work.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}

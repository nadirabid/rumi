#usda 1.0
(
    defaultPrim = "Model"
    doc = "Blender v4.5.15 LTS"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Model" (
    prepend apiSchemas = ["IsaacRobotAPI", "PhysicsArticulationRootAPI"]
    customData = {
        dictionary Blender = {
            bool generated = 1

{
  "name": "dsh-rumi",
  "description": "Rumi — a DeepSeek Harness app",
  "version": "0.2.3-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "pnpm run build:plugins && tsc -b && pnpm run bundle",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:print-studio-client": "node scripts/build-plugins.mjs print-studio",
    "bundle": "tsdown --config-loader native",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "test:updates:local": "pnpm run build && node scripts/test-local-updater.mjs",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "render:tray-icon": "tsx scripts/render-tray-icon.ts",
    "prepare:primary-runtime": "tsx scripts/prepare-primary-runtime.ts",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:dsh": "pnpm run build:plugins && tsx scripts/prepare-dsh.ts",
    "prepare:package": "tsx scripts/package-target.ts --prepare-only",
    "verify:mac-signature": "node scripts/verify-macos-signature.mjs",
    "package": "tsx scripts/package-target.ts",
    "check:package": "tsx scripts/package-target.ts --check",
    "restore:mac-proxy": "tsx scripts/macos-notarization-proxy.ts",
    "package:dir": "tsx scripts/package-target.ts --dir",
    "package:mac:arm64": "tsx scripts/package-target.ts mac-arm64",
    "package:mac:arm64:unsigned": "tsx scripts/package-target.ts mac-arm64 --unsigned",
    "package:mac:arm64:dir": "tsx scripts/package-target.ts mac-arm64 --dir",
    "package:mac:x64": "tsx scripts/package-target.ts mac-x64",
    "package:mac:x64:unsigned": "tsx scripts/package-target.ts mac-x64 --unsigned",
    "package:mac:x64:dir": "tsx scripts/package-target.ts mac-x64 --dir"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-error": "workspace:*",
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-client-hmr": "workspace:*",
    "@deepseek-ai/dsh-client-product-analytics": "workspace:*",
    "@deepseek-ai/dsh-client-shortcuts": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "workspace:*",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "@deepseek-ai/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-official-bundles": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@electron/get": "^5.1.0",
    "@electron/notarize": "2.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "app-builder-lib": "26.17.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "esbuild": "0.28.2",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.3.2",
    "koffi": "3.1.1",
    "pnpm": "11.28.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "zod": "4.6.6"
  },
  "imports": {
    "#print-studio-desktop/login": {
      "types": "./plugins/print-studio/desktop/bambu-login.ts",
      "default": "./plugins/print-studio/lib/desktop/bambu-login.js"
    }
  }
}
